<Project Sdk="Microsoft.NET.Sdk">
  <!-- End-to-end check of the plugin's Core (pairing, signing, outbox, sync, commands) against a running backend/emulator. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <UseWPF>false</UseWPF>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/NightManager.Core/NightManager.Core.csproj" />
  </ItemGroup>
</Project>
