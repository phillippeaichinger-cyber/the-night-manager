<Project>
  <!-- This is the single editable source of plugin identity and manifest metadata. -->
  <PropertyGroup>
    <PluginId>565D34C2-73CD-436B-8735-E2E9F98E8AFC</PluginId>
    <Version Condition="'$(Version)' == ''">2.1.0.0</Version>
    <AssemblyVersion>$(Version)</AssemblyVersion>
    <FileVersion>$(Version)</FileVersion>
    <Title Condition="'$(NmChannel)' != 'dev'">The Night Manager</Title>
    <Title Condition="'$(NmChannel)' == 'dev'">The Night Manager (dev)</Title>
    <AssemblyTitle>$(Title)</AssemblyTitle>
    <Product>$(Title)</Product>
    <Copyright>Copyright © 2026 BeyondBackyard</Copyright>
    <Company>Phil Aichinger</Company>
    <Authors>Phil Aichinger</Authors>
    <Description>Monitor your NINA observatory from your phone: live telemetry, smart alerts, sub grading and AI night reports.</Description>
    <PluginLongDescription></PluginLongDescription>
    <RepositoryUrl>https://github.com/phillippeaichinger-cyber/the-night-manager</RepositoryUrl>
    <PluginHomepage>https://www.ninanightagent.com</PluginHomepage>
    <PluginTags>monitoring,mobile,notifications,remote,alerts,android,iphone</PluginTags>
    <PluginLicense>MPL-2.0</PluginLicense>
    <PluginLicenseUrl>https://www.mozilla.org/en-US/MPL/2.0/</PluginLicenseUrl>
    <PluginChangelogUrl>https://github.com/phillippeaichinger-cyber/the-night-manager/blob/main/CHANGELOG.md</PluginChangelogUrl>
    <PluginFeaturedImageUrl>https://raw.githubusercontent.com/phillippeaichinger-cyber/the-night-manager/main/assets/logo.png</PluginFeaturedImageUrl>
    <PluginScreenshotUrl>https://raw.githubusercontent.com/phillippeaichinger-cyber/the-night-manager/main/assets/screenshot-1.png</PluginScreenshotUrl>
    <PluginAltScreenshotUrl>https://raw.githubusercontent.com/phillippeaichinger-cyber/the-night-manager/main/assets/screenshot-2.png</PluginAltScreenshotUrl>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.InteropServices.GuidAttribute"><_Parameter1>$(PluginId)</_Parameter1></AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.InteropServices.ComVisibleAttribute"><_Parameter1>false</_Parameter1></AssemblyAttribute>
    <AssemblyMetadata Include="MinimumApplicationVersion" Value="$(MinimumNinaVersion)" />
    <AssemblyMetadata Include="License" Value="$(PluginLicense)" />
    <AssemblyMetadata Include="LicenseURL" Value="$(PluginLicenseUrl)" />
    <AssemblyMetadata Include="Repository" Value="$(RepositoryUrl)" />
    <AssemblyMetadata Include="Homepage" Value="$(PluginHomepage)" />
    <AssemblyMetadata Include="Tags" Value="$(PluginTags)" />
    <AssemblyMetadata Include="LongDescription" Value="$(PluginLongDescription)" />
    <AssemblyMetadata Include="ChangelogURL" Value="$(PluginChangelogUrl)" />
    <AssemblyMetadata Include="FeaturedImageURL" Value="$(PluginFeaturedImageUrl)" />
    <AssemblyMetadata Include="ScreenshotURL" Value="$(PluginScreenshotUrl)" />
    <AssemblyMetadata Include="AltScreenshotURL" Value="$(PluginAltScreenshotUrl)" />
  </ItemGroup>
</Project>
