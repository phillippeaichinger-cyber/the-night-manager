<Project Sdk="Microsoft.NET.Sdk">
  <!-- Host-independent logic: no WPF, no NINA references, unit-testable on any OS. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <UseWPF>false</UseWPF>
    <Nullable>enable</Nullable>
    <RootNamespace>NightManager.Core</RootNamespace>
    <AssemblyName>NightManager.Core</AssemblyName>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Keep in step with Version in Plugin.props. -->
    <Version>2.0.0.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="NightManager.Core.Tests" />
  </ItemGroup>
</Project>
